          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data) {",
                  "    if (jsonData.data.orderId) pm.collectionVariables.set('razorpayOrderId', jsonData.data.orderId);",
                  "    if (jsonData.data.keyId) pm.collectionVariables.set('razorpayKeyId', jsonData.data.keyId);",
                  "    if (jsonData.data.amount) pm.collectionVariables.set('paymentAmount', jsonData.data.amount);",
                  "}",
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
