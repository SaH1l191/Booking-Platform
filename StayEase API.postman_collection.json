    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data) {",
                  "    if (jsonData.data.bookingId) pm.collectionVariables.set('bookingId', jsonData.data.bookingId);",
                  "    if (jsonData.data.idempotencyKey) pm.collectionVariables.set('idempotencyKey', jsonData.data.idempotencyKey);",
                  "    if (jsonData.data.expiresAt) pm.collectionVariables.set('expiresAt', jsonData.data.expiresAt);",
                  "}",
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hotelId\": 1,\n  \"roomId\": 10,\n  \"totalGuests\": 2,\n  \"bookingAmount\": 300,\n  \"checkIn\": \"2026-07-15\",\n  \"checkOut\": \"2026-07-18\"\n    ,\"idempotencyKey\":\"65ee9d37-0a5b-4ac0-8106-c4c0ebd50a5a\"\n\n}"
            },
            "url": {
