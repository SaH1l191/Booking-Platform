# Root environment (shared/infra defaults)

# PaymentService
PORT=3005
DBName=payment_db
DB_ADDR=127.0.0.1:3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NET=tcp
DB_DSN=root:your_db_password@tcp(127.0.0.1:3306)/payment_db

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# JWT
JWT_ACCESS_SECRET=change-me-to-a-random-secret
JWT_REFRESH_SECRET=change-me-to-another-random-secret

# Email (used by NotificationService)
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-gmail-app-password
