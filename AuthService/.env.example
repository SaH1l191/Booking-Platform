# AuthService — API Gateway & Authentication
PORT=3000

# MySQL Database
DBName=auth_db
DB_ADDR=127.0.0.1:3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NET=tcp
DB_DSN=root:your_db_password@tcp(127.0.0.1:3306)/auth_db

# JWT Secrets
JWT_ACCESS_SECRET=change-me-to-a-random-secret
JWT_REFRESH_SECRET=change-me-to-another-random-secret

# Downstream Service URLs
HOTEL_SERVICE_URL=http://localhost:3001
BOOKING_SERVICE_URL=http://localhost:3002
REVIEW_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3005

# Logging
LOG_PATH=../logs
