# BookingService — Booking CRUD, Outbox, Redlock
PORT=3002

# MySQL Database
DATABASE_URL=mysql://root:your_db_password@localhost:3306/airbnb_development1
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=airbnb_development1

# Redis (for Redlock + availability cache)
REDIS_SERVER_URL=redis://localhost:6379
REDLOCK_TTL=30000
REDIS_LOCK_TTL=900000

# Booking Hold
BOOKING_EXPIRY_MS=900000

# Logging
LOG_PATH=../logs
