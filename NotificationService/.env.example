# NotificationService — Email via Gmail SMTP + RabbitMQ Consumers
PORT=3003

# MySQL Database (for optional lookups)
DB_USER=root
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_DATABASE=airbnb_development

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SERVER_URL=redis://localhost:6379

# Gmail SMTP (use app password, not your account password)
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-gmail-app-password

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Logging
LOG_PATH=../logs
