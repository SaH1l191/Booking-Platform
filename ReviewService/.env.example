# ReviewService — Reviews & Eligibility
PORT=3004

# MySQL Database
DBName=review_service
DB_ADDR=127.0.0.1:3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NET=tcp
DB_DSN=root:your_db_password@tcp(127.0.0.1:3306)/review_service

# JWT Secrets (for token validation)
JWT_ACCESS_SECRET=change-me-to-a-random-secret
JWT_REFRESH_SECRET=change-me-to-another-random-secret

# Logging
LOG_PATH=../logs
