# HotelService — Hotels, Rooms, Categories, Geospatial Search
PORT=3001

# MySQL Database
DB_USER=root
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_DATABASE=airbnb_development

# Redis (for caching)
REDIS_SERVER_URL=redis://localhost:6379
LOCK_TTL=900000

# JWT Secrets (for token validation)
JWT_ACCESS_SECRET=change-me-to-a-random-secret
JWT_REFRESH_SECRET=change-me-to-another-random-secret

# Logging
LOG_PATH=../logs
