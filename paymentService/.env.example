# PaymentService — Razorpay Integration
PORT=3005

# MySQL Database
DB_USER=root
DB_PASSWORD=your_db_password
DB_NET=tcp
DB_ADDR=127.0.0.1:3306
DB_NAME=payment_db

# JWT Secret (for token validation)
JWT_ACCESS_SECRET=change-me-to-a-random-secret

# Razorpay API Keys (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SERVER_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Logging
LOG_PATH=../logs


ngrok http 3000
https://<id>.ngrok-free.app/api/v1/payments/webhook